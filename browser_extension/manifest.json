{
  "manifest_version": 2,
  "name": "localAI Browser Agent",
  "version": "0.1.0",
  "description": "Connects Firefox active tabs to the localAI browser agent.",
  "permissions": ["tabs", "http://127.0.0.1:8765/*", "<all_urls>"],
  "background": {"scripts": ["background.js"]},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}],
  "browser_specific_settings": {"gecko": {"id": "browser-agent@localai"}}
}
